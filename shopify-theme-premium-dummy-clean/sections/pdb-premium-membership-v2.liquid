<section class="pdb-premium-v4" data-ui-revision="{{ section.settings.deployment_revision | escape }}">
  <style>
    .pdb-premium-v4{
      --pdb-bg:#ffffff;
      --pdb-text:#171717;
      --pdb-muted:#666666;
      --pdb-soft:#f8f4ef;
      --pdb-soft-2:#fcfaf8;
      --pdb-line:rgba(0,0,0,0.08);
      --pdb-accent:#d9bfa9;
      --pdb-accent-dark:#b89578;
      --pdb-gold:linear-gradient(135deg,#ead8c8 0%,#d8b79a 48%,#b58c6d 100%);
      --pdb-dark:linear-gradient(135deg,#161616 0%,#23201e 55%,#312b27 100%);
      --pdb-shadow:0 20px 50px rgba(0,0,0,0.08);
      --pdb-shadow-soft:0 12px 30px rgba(0,0,0,0.05);
      --pdb-max:1340px;
      background:var(--pdb-bg)!important;
      color:var(--pdb-text)!important;
      width:100%!important;
      display:block!important;
      position:relative!important;
      overflow:hidden!important;
      font-family:inherit!important;
    }
    .pdb-premium-v4 *{box-sizing:border-box!important}
    .pdb-premium-v4 a{text-decoration:none;color:inherit}
    .pdb-premium-v4 img{max-width:100%;display:block}
    .pdb-premium-v4 .pdb-wrap{max-width:var(--pdb-max);margin:0 auto;padding:0 22px;position:relative;z-index:2}
    .pdb-premium-v4 .pdb-section{padding:74px 0;position:relative}
    .pdb-premium-v4 .pdb-grid{display:grid;gap:22px}

    .pdb-premium-v4 h1,
    .pdb-premium-v4 h2,
    .pdb-premium-v4 h3,
    .pdb-premium-v4 h4{
      margin:0 0 14px;
      color:var(--pdb-text);
      line-height:1.08;
      letter-spacing:-0.025em;
    }
    .pdb-premium-v4 h1{font-size:clamp(38px,6.2vw,70px)}
    .pdb-premium-v4 h2{font-size:clamp(28px,4vw,46px)}
    .pdb-premium-v4 h3{font-size:clamp(20px,2.6vw,28px)}
    .pdb-premium-v4 h4{font-size:18px}
    .pdb-premium-v4 p{
      margin:0 0 14px;
      color:var(--pdb-muted);
      font-size:16px;
      line-height:1.8;
    }
    .pdb-premium-v4 .pdb-lead{font-size:18px;color:#4a4a4a}
    .pdb-premium-v4 .pdb-center-head{max-width:860px;margin:0 auto 30px;text-align:center}
    .pdb-premium-v4 .pdb-center-head p{margin-left:auto;margin-right:auto}
    .pdb-premium-v4 .pdb-eyebrow{
      display:inline-flex;
      align-items:center;
      gap:10px;
      min-height:34px;
      padding:8px 14px;
      border-radius:999px;
      font-size:12px;
      letter-spacing:.18em;
      text-transform:uppercase;
      font-weight:700;
      color:#6f5946;
      background:rgba(255,255,255,.82);
      border:1px solid rgba(0,0,0,.06);
      backdrop-filter:blur(8px);
      margin-bottom:14px;
    }
    .pdb-premium-v4 .pdb-eyebrow:before{
      content:"";
      width:7px;height:7px;border-radius:999px;
      background:var(--pdb-accent);
      box-shadow:0 0 0 6px rgba(217,191,169,.18);
    }

    .pdb-premium-v4 .pdb-anchor{position:relative;top:-120px;display:block;visibility:hidden}
    .pdb-premium-v4 .pdb-hidden{display:none!important}

    .pdb-premium-v4 .pdb-hero{padding:26px 0 42px}
    .pdb-premium-v4 .pdb-hero-shell{
      position:relative;
      border-radius:36px;
      overflow:hidden;
      background:
        radial-gradient(circle at 8% 14%, rgba(217,191,169,.26), transparent 24%),
        radial-gradient(circle at 92% 18%, rgba(217,191,169,.18), transparent 24%),
        radial-gradient(circle at 72% 86%, rgba(0,0,0,.03), transparent 20%),
        linear-gradient(135deg,#fffdfa 0%,#f9f2eb 55%,#f6eee8 100%);
      border:1px solid rgba(0,0,0,.05);
      box-shadow:var(--pdb-shadow);
      padding:42px 38px;
    }
    .pdb-premium-v4 .pdb-hero-shell:before{
      content:"";
      position:absolute;
      width:460px;height:460px;border-radius:999px;
      right:-160px;top:-180px;
      background:radial-gradient(circle, rgba(217,191,169,.20) 0%, rgba(217,191,169,0) 70%);
      pointer-events:none;
    }
    .pdb-premium-v4 .pdb-hero-grid{
      display:grid;
      grid-template-columns:1.12fr .88fr;
      gap:28px;
      align-items:center;
    }
    .pdb-premium-v4 .pdb-hero-copy{max-width:780px}
    .pdb-premium-v4 .pdb-hero-sub{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:14px;
      margin:24px 0 26px;
    }
    .pdb-premium-v4 .pdb-mini-stat{
      padding:16px;
      border-radius:18px;
      background:rgba(255,255,255,.72);
      border:1px solid rgba(0,0,0,.06);
      box-shadow:0 10px 26px rgba(0,0,0,.04);
    }
    .pdb-premium-v4 .pdb-mini-stat strong{
      display:block;
      font-size:22px;
      line-height:1;
      margin-bottom:8px;
      color:#202020;
    }
    .pdb-premium-v4 .pdb-mini-stat span{
      display:block;
      color:#646464;
      font-size:14px;
      line-height:1.6;
    }
    .pdb-premium-v4 .pdb-chip-row{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      margin:18px 0 0;
    }
    .pdb-premium-v4 .pdb-chip{
      display:inline-flex;
      align-items:center;
      gap:8px;
      min-height:38px;
      padding:10px 14px;
      border-radius:999px;
      background:rgba(255,255,255,.74);
      border:1px solid rgba(0,0,0,.06);
      font-size:13px;
      font-weight:600;
      color:#4d4d4d;
    }
    .pdb-premium-v4 .pdb-chip:before{
      content:"✦";
      font-size:10px;
      color:var(--pdb-accent-dark)
    }
    .pdb-premium-v4 .pdb-actions{
      display:flex;
      flex-wrap:wrap;
      gap:12px;
      margin-top:22px
    }
    .pdb-premium-v4 .pdb-btn,
    .pdb-premium-v4 .pdb-btn-secondary{
      min-height:52px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:14px 22px;
      border-radius:14px;
      font-size:13px;
      letter-spacing:.08em;
      text-transform:uppercase;
      font-weight:800;
      transition:.25s ease;
      text-align:center
    }
    .pdb-premium-v4 .pdb-btn{
      background:var(--pdb-gold);
      color:#fff!important;
      box-shadow:0 18px 40px rgba(181,140,109,.25);
    }
    .pdb-premium-v4 .pdb-btn:hover{transform:translateY(-2px)}
    .pdb-premium-v4 .pdb-btn-secondary{
      background:#fff;
      border:1px solid rgba(0,0,0,.08);
      color:#353535!important;
    }
    .pdb-premium-v4 .pdb-btn-secondary:hover{transform:translateY(-2px)}

    .pdb-premium-v4 .pdb-hero-visual{
      position:relative;
      min-height:100%;
      display:grid;
      gap:16px;
    }
    .pdb-premium-v4 .pdb-glass-card{
      position:relative;
      overflow:hidden;
      border-radius:28px;
      padding:24px;
      background:rgba(255,255,255,.80);
      border:1px solid rgba(0,0,0,.06);
      box-shadow:0 18px 42px rgba(0,0,0,.06);
      backdrop-filter:blur(10px);
    }
    .pdb-premium-v4 .pdb-glass-card:before{
      content:"";
      position:absolute;
      inset:0 auto auto 0;
      width:100%;
      height:3px;
      background:var(--pdb-gold);
    }
    .pdb-premium-v4 .pdb-tier-stack{
      display:grid;
      gap:12px;
      margin-top:16px;
    }
    .pdb-premium-v4 .pdb-tier-strip{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding:14px 16px;
      border-radius:18px;
      background:#fff;
      border:1px solid rgba(0,0,0,.06)
    }
    .pdb-premium-v4 .pdb-tier-strip strong{font-size:16px;color:#1f1f1f}
    .pdb-premium-v4 .pdb-tier-strip span{font-size:13px;color:#666}
    .pdb-premium-v4 .pdb-tier-badge{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:66px;
      height:34px;
      padding:0 12px;
      border-radius:999px;
      background:rgba(217,191,169,.18);
      font-size:11px;
      font-weight:800;
      letter-spacing:.08em;
      text-transform:uppercase;
      color:#6e5644
    }
    .pdb-premium-v4 .pdb-note{
      margin-top:14px;
      font-size:13px;
      color:#8a8a8a;
      line-height:1.7;
    }

    .pdb-premium-v4 .pdb-benefit-grid{grid-template-columns:repeat(4,1fr)}
    .pdb-premium-v4 .pdb-benefit{
      border-radius:24px;
      padding:24px;
      background:#fff;
      border:1px solid var(--pdb-line);
      box-shadow:var(--pdb-shadow-soft);
      min-height:100%;
    }
    .pdb-premium-v4 .pdb-icon{
      width:54px;
      height:54px;
      border-radius:16px;
      display:grid;
      place-items:center;
      background:linear-gradient(180deg, rgba(217,191,169,.22), rgba(217,191,169,.08));
      border:1px solid rgba(185,144,111,.16);
      margin-bottom:16px;
      font-size:20px;
    }

    .pdb-premium-v4 .pdb-plan-grid{
      grid-template-columns:repeat(4,minmax(0,1fr));
      align-items:stretch
    }
    .pdb-premium-v4 .pdb-plan{
      position:relative;
      display:flex;
      flex-direction:column;
      border-radius:30px;
      background:#fff;
      border:1px solid rgba(0,0,0,.07);
      box-shadow:0 18px 40px rgba(0,0,0,.05);
      overflow:hidden;
      min-height:100%;
    }
    .pdb-premium-v4 .pdb-plan.featured{
      border-color:rgba(185,144,111,.24);
      box-shadow:0 24px 48px rgba(185,144,111,.18);
    }
    .pdb-premium-v4 .pdb-plan.featured:before{
      content:"";
      position:absolute;
      inset:0 0 auto 0;
      height:4px;
      background:var(--pdb-gold)
    }
    .pdb-premium-v4 .pdb-plan-mark{
      position:absolute;
      top:16px;
      right:16px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:28px;
      padding:6px 10px;
      border-radius:999px;
      background:#111;
      color:#fff;
      font-size:9px;
      letter-spacing:.12em;
      text-transform:uppercase;
      font-weight:800
    }
    .pdb-premium-v4 .pdb-plan-head{padding:28px 24px 16px}
    .pdb-premium-v4 .pdb-plan-sub{font-size:14px;color:#767676;margin-bottom:14px}
    .pdb-premium-v4 .pdb-plan-price{
      display:flex;
      align-items:flex-end;
      gap:8px;
      margin-bottom:14px
    }
    .pdb-premium-v4 .pdb-plan-price strong{
      font-size:48px;
      line-height:1;
      color:#171717;
      letter-spacing:-.04em
    }
    .pdb-premium-v4 .pdb-plan-price span{
      font-size:14px;
      color:#6e6e6e;
      padding-bottom:8px
    }
    .pdb-premium-v4 .pdb-plan-copy{font-size:15px;line-height:1.75}
    .pdb-premium-v4 .pdb-plan-body{
      padding:0 24px 24px;
      display:flex;
      flex-direction:column;
      gap:18px;
      flex:1 1 auto
    }
    .pdb-premium-v4 .pdb-list{
      list-style:none;
      padding:0;
      margin:0;
      display:grid;
      gap:12px
    }
    .pdb-premium-v4 .pdb-list li{
      position:relative;
      padding-left:28px;
      font-size:15px;
      line-height:1.7;
      color:#404040
    }
    .pdb-premium-v4 .pdb-list li:before{
      content:"✓";
      position:absolute;
      left:0;
      top:0;
      color:var(--pdb-accent-dark);
      font-weight:800
    }
    .pdb-premium-v4 .pdb-tag-row{
      display:flex;
      flex-wrap:wrap;
      gap:8px
    }
    .pdb-premium-v4 .pdb-tag{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:30px;
      padding:6px 10px;
      border-radius:999px;
      font-size:10px;
      letter-spacing:.08em;
      text-transform:uppercase;
      font-weight:800;
      background:rgba(217,191,169,.16);
      color:#67503e
    }
    .pdb-premium-v4 .pdb-plan-cta{margin-top:auto}
    .pdb-premium-v4 .pdb-plan-cta .pdb-btn,
    .pdb-premium-v4 .pdb-plan-cta .pdb-btn-secondary{width:100%}

    .pdb-premium-v4 .pdb-plan.private{
      color:#f8f3ed;
      border-color:rgba(217,191,169,.34);
      background:
        radial-gradient(circle at 100% 0,rgba(217,191,169,.16),transparent 30%),
        linear-gradient(145deg,#121110 0%,#24201d 100%);
      box-shadow:0 28px 60px rgba(18,17,16,.24)
    }
    .pdb-premium-v4 .pdb-plan.private h3,
    .pdb-premium-v4 .pdb-plan.private .pdb-plan-price strong,
    .pdb-premium-v4 .pdb-plan.private .pdb-list li{color:#fff}
    .pdb-premium-v4 .pdb-plan.private p,
    .pdb-premium-v4 .pdb-plan.private .pdb-plan-sub,
    .pdb-premium-v4 .pdb-plan.private .pdb-plan-price span{color:rgba(255,255,255,.68)}
    .pdb-premium-v4 .pdb-plan.private .pdb-eyebrow{
      color:#f0d7c2;
      background:rgba(255,255,255,.07);
      border-color:rgba(255,255,255,.12)
    }
    .pdb-premium-v4 .pdb-plan.private .pdb-tag{
      color:#f0d7c2;
      background:rgba(217,191,169,.14)
    }
    .pdb-premium-v4 .pdb-plan.private .pdb-btn{
      background:#f3e4d8;
      color:#191614!important;
      box-shadow:none
    }
    .pdb-premium-v4 .pdb-price-future{
      display:block;
      margin:-4px 0 14px;
      color:#795e49;
      font-size:12px;
      font-weight:800;
      letter-spacing:.02em
    }
    .pdb-premium-v4 .pdb-plan-choice.is-selected{
      outline:3px solid rgba(185,144,111,.24);
      outline-offset:3px
    }

    .pdb-premium-v4 .pdb-contract-shell{
      margin-top:34px;
      border-radius:30px;
      padding:30px;
      background:#fff;
      border:1px solid rgba(0,0,0,.08);
      box-shadow:var(--pdb-shadow)
    }
    .pdb-premium-v4 .pdb-contract-head{
      display:grid;
      grid-template-columns:minmax(0,1fr) auto;
      gap:24px;
      align-items:end;
      padding-bottom:22px;
      border-bottom:1px solid var(--pdb-line)
    }
    .pdb-premium-v4 .pdb-contract-total{text-align:right}
    .pdb-premium-v4 .pdb-contract-total strong{display:block;font-size:24px;color:#171717}
    .pdb-premium-v4 .pdb-contract-total span{font-size:12px;color:#777}
    .pdb-premium-v4 .pdb-contract-disclosure{margin-top:22px}
    .pdb-premium-v4 .pdb-contract-disclosure summary{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:22px;
      min-height:74px;
      padding:16px 18px;
      border:1px solid rgba(0,0,0,.1);
      border-radius:16px;
      background:#f8f5f2;
      color:#171717;
      cursor:pointer;
      list-style:none;
      touch-action:manipulation
    }
    .pdb-premium-v4 .pdb-contract-disclosure summary::-webkit-details-marker{display:none}
    .pdb-premium-v4 .pdb-contract-disclosure summary:hover{border-color:#b89578;background:#f5eee8}
    .pdb-premium-v4 .pdb-contract-disclosure summary:focus-visible{
      outline:3px solid rgba(217,191,169,.34);
      outline-offset:3px
    }
    .pdb-premium-v4 .pdb-contract-disclosure-copy{display:grid;gap:3px;min-width:0}
    .pdb-premium-v4 .pdb-contract-disclosure-copy strong{font-size:16px;line-height:1.35}
    .pdb-premium-v4 .pdb-contract-disclosure-copy small{color:#736b65;font-size:13px;line-height:1.45}
    .pdb-premium-v4 .pdb-contract-disclosure-action{
      flex:0 0 auto;
      display:inline-flex;
      align-items:center;
      gap:10px;
      color:#785a44;
      font-size:12px;
      font-weight:850;
      letter-spacing:.06em;
      text-transform:uppercase
    }
    .pdb-premium-v4 .pdb-contract-disclosure-action::after{
      content:'+';
      display:grid;
      place-items:center;
      width:30px;
      height:30px;
      border-radius:50%;
      background:#fff;
      border:1px solid rgba(0,0,0,.1);
      font-size:20px;
      line-height:1
    }
    .pdb-premium-v4 .pdb-contract-disclosure[open] summary{border-color:#cbb39f;background:#f7f0ea}
    .pdb-premium-v4 .pdb-contract-disclosure[open] .pdb-contract-disclosure-action::after{content:'−'}
    .pdb-premium-v4 .pdb-contract-disclosure-action-open{display:none}
    .pdb-premium-v4 .pdb-contract-disclosure[open] .pdb-contract-disclosure-action-closed{display:none}
    .pdb-premium-v4 .pdb-contract-disclosure[open] .pdb-contract-disclosure-action-open{display:inline}
    .pdb-premium-v4 .pdb-contract-disclosure-body{padding-top:2px}
    .pdb-premium-v4 .pdb-contract-form{display:grid;gap:22px;margin-top:24px}
    .pdb-premium-v4 .pdb-contract-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
    .pdb-premium-v4 .pdb-contract-field.full{grid-column:1/-1}
    .pdb-premium-v4 .pdb-contract-field label{
      display:block;
      margin-bottom:7px;
      color:#242424;
      font-size:12px;
      font-weight:800;
      letter-spacing:.05em;
      text-transform:uppercase
    }
    .pdb-premium-v4 .pdb-required-mark{
      margin-left:2px;
      color:#8b6042;
      font-weight:900
    }
    .pdb-premium-v4 .pdb-required-note,
    .pdb-premium-v4 .pdb-field-help{
      margin:7px 0 0;
      color:#766c64;
      font-size:12px;
      line-height:1.5
    }
    .pdb-premium-v4 .pdb-contract-field input,
    .pdb-premium-v4 .pdb-contract-field select{
      width:100%;
      min-height:50px;
      margin:0;
      padding:12px 14px;
      border:1px solid rgba(0,0,0,.14);
      border-radius:12px;
      background:#fff;
      color:#171717;
      font:inherit
    }
    .pdb-premium-v4 .pdb-contract-field select{
      appearance:none;
      -webkit-appearance:none;
      padding-right:46px;
      background-image:
        linear-gradient(45deg,transparent 50%,#3a332e 50%),
        linear-gradient(135deg,#3a332e 50%,transparent 50%);
      background-position:
        calc(100% - 21px) 50%,
        calc(100% - 15px) 50%;
      background-size:6px 6px,6px 6px;
      background-repeat:no-repeat;
      cursor:pointer
    }
    .pdb-premium-v4 .pdb-contract-field input:focus,
    .pdb-premium-v4 .pdb-contract-field select:focus{
      outline:3px solid rgba(217,191,169,.26);
      border-color:#b89578
    }
    .pdb-premium-v4 .pdb-contract-checks{display:grid;gap:12px}
    .pdb-premium-v4 .pdb-contract-check{
      display:grid;
      grid-template-columns:22px 1fr;
      gap:10px;
      align-items:start;
      color:#3e3e3e;
      font-size:14px;
      line-height:1.55
    }
    .pdb-premium-v4 .pdb-contract-check input{width:18px;height:18px;margin:2px 0 0}
    .pdb-premium-v4 .pdb-contract-check a{text-decoration:underline;text-underline-offset:2px}
    .pdb-premium-v4 .pdb-contract-status{
      display:none;
      padding:16px 18px;
      border-radius:14px;
      background:#f8f4ef;
      border:1px solid rgba(0,0,0,.08);
      color:#262626;
      font-size:14px;
      line-height:1.6
    }
    .pdb-premium-v4 .pdb-contract-status.is-visible{display:block}
    .pdb-premium-v4 .pdb-contract-status.is-error{background:#fff5f3;border-color:#e7b9b0;color:#7b2d22}
    .pdb-premium-v4 .pdb-contract-progress{display:grid;gap:9px;padding:14px 16px;border:1px solid #dfd4ca;border-radius:14px;background:#fbf8f5;color:#4e4741;font-size:14px}
    .pdb-premium-v4 .pdb-contract-progress[hidden]{display:none}
    .pdb-premium-v4 .pdb-contract-progress-track{height:5px;overflow:hidden;border-radius:999px;background:#e7ddd4}
    .pdb-premium-v4 .pdb-contract-progress-bar{display:block;width:45%;height:100%;border-radius:inherit;background:#8b6a52;animation:pdb-contract-loading 1.15s ease-in-out infinite}
    @keyframes pdb-contract-loading{0%{transform:translateX(-110%)}100%{transform:translateX(245%)}}
    @media (prefers-reduced-motion:reduce){.pdb-premium-v4 .pdb-contract-progress-bar{width:100%;animation:none}}
