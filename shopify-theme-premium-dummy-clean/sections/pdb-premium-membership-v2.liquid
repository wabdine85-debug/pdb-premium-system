 <script>


  (function () {
    var root = document.querySelector('.pdb-premium-v4');
    if (!root) return;

    document.body.classList.add('pdb-premium-page');

    var shopifyCustomerId = '{{ customer.id | default: "" }}';

    var isLoggedIn = !!shopifyCustomerId;

    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var planObserver = new IntersectionObserver(function (entries, observer) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in-view');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.12 });
      root.querySelectorAll('.pdb-plan').forEach(function (plan, index) {
        plan.style.setProperty('--pdb-enter-delay', (index * 70) + 'ms');
        planObserver.observe(plan);
      });
    }

    var valueProof = root.querySelector('.pdb-value-proof');
    if (valueProof && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var proofObserver = new IntersectionObserver(function (entries, observer) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in-view');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.25 });
      proofObserver.observe(valueProof);
    }

    var cats = root.querySelectorAll('.pdb-cat');
    if (cats.length) {
      cats.forEach(function (cat) {
        var btn = cat.querySelector('.pdb-cat-btn');
        var panel = cat.querySelector('.pdb-cat-panel');
        var moreBtn = cat.querySelector('.pdb-treatment-more');
        var treatmentGrid = cat.querySelector('.pdb-treatment-grid');

        if (!btn) return;

        btn.setAttribute(
          'aria-expanded',
          cat.classList.contains('active') ? 'true' : 'false'
        );

        btn.addEventListener('click', function () {
          var shouldOpen = !cat.classList.contains('active');

          cats.forEach(function (otherCat) {
            var otherBtn = otherCat.querySelector('.pdb-cat-btn');
            var otherPanel = otherCat.querySelector('.pdb-cat-panel');
            var otherMoreBtn = otherCat.querySelector('.pdb-treatment-more');
            var otherTreatmentGrid = otherCat.querySelector('.pdb-treatment-grid');

            otherCat.classList.remove('active');
            if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
            if (otherPanel) otherPanel.hidden = true;
            if (otherTreatmentGrid) {
              otherTreatmentGrid.classList.remove('is-expanded');
            }
            if (otherMoreBtn) {
              otherMoreBtn.setAttribute('aria-expanded', 'false');
              if (otherMoreBtn.dataset.collapsedLabel) {
                otherMoreBtn.textContent = otherMoreBtn.dataset.collapsedLabel;
              }
            }
          });

          if (shouldOpen) {
            cat.classList.add('active');
            btn.setAttribute('aria-expanded', 'true');
            if (panel) panel.hidden = false;
          }
        });

        if (panel) {
          panel.hidden = !cat.classList.contains('active');
        }

        if (moreBtn && treatmentGrid) {
          var expandedLabel = moreBtn.textContent.trim();
          var collapsedLabel = 'Weniger Behandlungen anzeigen';
          moreBtn.dataset.collapsedLabel = expandedLabel;

          moreBtn.addEventListener('click', function () {
            var isExpanded = treatmentGrid.classList.toggle('is-expanded');
            moreBtn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
            moreBtn.textContent = isExpanded ? collapsedLabel : expandedLabel;
          });
        }
      });
    }

    root.querySelectorAll('.pdb-treatment').forEach(function (treatment, index) {
      var description = treatment.querySelector('p');
      if (!description || description.textContent.trim().length < 105) return;
      var descriptionId = 'pdb-treatment-description-' + index;
      description.id = descriptionId;
      var toggle = document.createElement('button');
      toggle.type = 'button';
      toggle.className = 'pdb-treatment-detail-toggle';
      toggle.textContent = 'Mehr erfahren';
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-controls', descriptionId);
      toggle.addEventListener('click', function () {
        var isOpen = treatment.classList.toggle('is-detail-open');
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        toggle.textContent = isOpen ? 'Weniger anzeigen' : 'Mehr erfahren';
      });
      treatment.appendChild(toggle);
    });

    var contractForm = document.getElementById('pdb-membership-contract-form');
    var packageSelect = document.getElementById('pdb-package');
    var contractTotal = document.getElementById('pdb-contract-total');
    var contractMonthly = document.getElementById('pdb-contract-monthly');
    var orderPackage = document.getElementById('pdb-order-package');
    var orderMonthly = document.getElementById('pdb-order-monthly');
    var contractStatus = document.getElementById('pdb-contract-status');
    var contractProgress = document.getElementById('pdb-contract-progress');
    var contractSubmit = document.getElementById('pdb-contract-submit');
    var contractSuccess = document.getElementById('pdb-contract-success');
    var successReference = document.getElementById('pdb-success-reference');
    var successPackage = document.getElementById('pdb-success-package');
    var successStart = document.getElementById('pdb-success-start');
    var successMonthly = document.getElementById('pdb-success-monthly');
    var successIban = document.getElementById('pdb-success-iban');
    var successEmailNote = document.getElementById('pdb-success-email-note');
    var successDownload = document.getElementById('pdb-success-download');
    var publicPackageSelect = document.getElementById('pdb-public-package');
    var publicOrderPackage = document.getElementById('pdb-public-order-package');
    var publicOrderMonthly = document.getElementById('pdb-public-order-monthly');
    var contractShell = document.getElementById('pdb-premium-contract');
    var contractLoginLink = document.getElementById('pdb-contract-login-link');
    var contractDisclosure = document.getElementById('pdb-contract-disclosure');
    var selectedPackageStorageKey = 'pdb_selected_package';
    var packageOffers = {
      pure: { name: 'PURE', monthly: '149,00 €', monthlyHero: '149 € / Monat', total: '1.837,00 €' },
      define: { name: 'DEFINE', monthly: '169,00 €', monthlyHero: '169 € / Monat', total: '2.077,00 €' },
      beyond: { name: 'BEYOND', monthly: '199,00 €', monthlyHero: '199 € / Monat', total: '2.437,00 €' },
      private: { name: 'PRIVATE', monthly: '399,00 €', monthlyHero: '399 € / Monat', total: '4.837,00 €' }
    };
    var updatePublicPackage;

    function getStoredPackage() {
      try {
        return sessionStorage.getItem(selectedPackageStorageKey) || '';
      } catch (error) {
        return '';
      }
    }

    function rememberPackage(packageKey) {
      try {
        sessionStorage.setItem(selectedPackageStorageKey, packageKey);
      } catch (error) {
        // The return URL still preserves the selection when storage is unavailable.
      }
    }

    function updateLoginReturnUrl(packageKey) {
      if (!contractLoginLink || !packageOffers[packageKey]) return;
      var loginUrl = new URL('{{ routes.storefront_login_url }}', window.location.origin);
      loginUrl.searchParams.set(
        'return_to',
        '/pages/premium?continue=contract&package=' + encodeURIComponent(packageKey) + '#pdb-premium-contract'
      );
      contractLoginLink.href = loginUrl.pathname + loginUrl.search;
    }

    function updateSelectedPackage(packageKey) {
      if (!packageOffers[packageKey]) return;
      rememberPackage(packageKey);
      updateLoginReturnUrl(packageKey);
      if (packageSelect) packageSelect.value = packageKey;
      if (publicPackageSelect) publicPackageSelect.value = packageKey;
      if (contractTotal) contractTotal.textContent = packageOffers[packageKey].total;
      if (contractMonthly) contractMonthly.textContent = packageOffers[packageKey].monthlyHero;
      if (orderPackage) orderPackage.textContent = packageOffers[packageKey].name;
      if (orderMonthly) orderMonthly.textContent = packageOffers[packageKey].monthly;
      root.querySelectorAll('[data-package-card]').forEach(function (card) {
        card.classList.toggle('is-selected', card.getAttribute('data-package-card') === packageKey);
      });
      if (typeof updatePublicPackage === 'function') updatePublicPackage();
    }

    root.querySelectorAll('[data-pdb-package]').forEach(function (button) {
      button.addEventListener('click', function () {
        updateSelectedPackage(button.getAttribute('data-pdb-package'));
        if (contractDisclosure) contractDisclosure.open = true;
      });
    });

    if (publicPackageSelect) {
      updatePublicPackage = function () {
        var offer = packageOffers[publicPackageSelect.value];
        if (!offer) return;
        if (contractMonthly) contractMonthly.textContent = offer.monthlyHero;
        if (publicOrderPackage) publicOrderPackage.textContent = offer.name;
        if (publicOrderMonthly) publicOrderMonthly.textContent = offer.monthly;
      };
      publicPackageSelect.addEventListener('change', function () {
        updateSelectedPackage(publicPackageSelect.value);
      });
    }

    if (packageSelect) {
      packageSelect.addEventListener('change', function () {
        updateSelectedPackage(packageSelect.value);
      });
    }

    var packageFromUrl = new URLSearchParams(window.location.search).get('package') || '';
    var preferredPackage = packageOffers[packageFromUrl]
      ? packageFromUrl
      : getStoredPackage();
    var initialPackage = packageOffers[preferredPackage]
      ? preferredPackage
      : (packageSelect ? packageSelect.value : (publicPackageSelect ? publicPackageSelect.value : 'beyond'));
    updateSelectedPackage(initialPackage);

    var shouldContinueContract = isLoggedIn && contractShell && (
      new URLSearchParams(window.location.search).get('continue') === 'contract' ||
      window.location.hash === '#pdb-premium-contract'
    );
    if (shouldContinueContract) {
      if (contractDisclosure) contractDisclosure.open = true;
      contractShell.setAttribute('tabindex', '-1');
      window.setTimeout(function () {
        contractShell.focus({ preventScroll: true });
        contractShell.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 180);
    }

    var startInput = document.getElementById('pdb-start');
    if (startInput && !startInput.value) {
      var now = new Date();
      var nextStart = new Date(now.getFullYear(), now.getMonth() + 1, 1, 12, 0, 0);
      var startValue = nextStart.getFullYear() + '-' + String(nextStart.getMonth() + 1).padStart(2, '0') + '-01';
      startInput.value = startValue;
      startInput.min = startValue;
    }

    var ibanInput = document.getElementById('pdb-iban');
    if (ibanInput) {
      function hasValidIbanChecksum(value) {
        var iban = String(value || '').replace(/\s+/g, '').toUpperCase();
        if (!/^[A-Z]{2}\d{2}[A-Z0-9]{11,30}$/.test(iban)) return false;
        var rearranged = iban.slice(4) + iban.slice(0, 4);
        var remainder = 0;
        for (var character of rearranged) {
          var expanded = /[A-Z]/.test(character) ? String(character.charCodeAt(0) - 55) : character;
          for (var digit of expanded) remainder = (remainder * 10 + Number(digit)) % 97;
        }
        return remainder === 1;
      }

      function validateIbanField() {
        if (!ibanInput.value.trim()) {
          ibanInput.setCustomValidity('Bitte geben Sie Ihre IBAN ein.');
        } else if (!hasValidIbanChecksum(ibanInput.value)) {
          ibanInput.setCustomValidity('Bitte prüfen Sie die IBAN. Die Prüfsumme ist nicht gültig.');
        } else {
          ibanInput.setCustomValidity('');
        }
      }

      ibanInput.addEventListener('input', function () {
        var compact = ibanInput.value.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 34);
        ibanInput.value = compact.replace(/(.{4})/g, '$1 ').trim();
        ibanInput.setCustomValidity('');
      });
      ibanInput.addEventListener('blur', validateIbanField);
    }

    function showContractStatus(message, isError) {
      if (!contractStatus) return;
      contractStatus.classList.add('is-visible');
      contractStatus.classList.toggle('is-error', !!isError);
      contractStatus.innerHTML = message;
    }

    function getSafeContractUrl(url) {
      if (typeof url !== 'string') return '';
      return /^\/apps\/pdb\/contracts\/[a-z-]+\?(?:token|id)=[A-Za-z0-9_%.-]+$/.test(url) ? url : '';
    }

    function formatContractDate(value) {
      var parts = String(value || '').split('-').map(Number);
      if (parts.length !== 3 || !parts[0] || !parts[1] || !parts[2]) return '–';
      return new Intl.DateTimeFormat('de-DE').format(new Date(parts[0], parts[1] - 1, parts[2], 12, 0, 0));
    }

    function maskContractEmail(value) {
      var parts = String(value || '').split('@');
      if (parts.length !== 2) return 'Ihre E-Mail-Adresse';
      var local = parts[0];
      var visible = local.slice(0, Math.min(2, local.length));
      return visible + '•••@' + parts[1];
    }

    function showContractSuccess(result, payload, confirmationUrl, shouldFocus) {
      if (!contractForm || !contractSuccess) return;
      var offer = packageOffers[payload.package_key] || {};
      if (successReference) successReference.textContent = result.application.mandate_reference || '–';
      if (successPackage) successPackage.textContent = offer.name || String(payload.package_key || '').toUpperCase();
      if (successStart) successStart.textContent = formatContractDate(payload.starts_on);
      if (successMonthly) successMonthly.textContent = offer.monthly || '–';
      if (successIban) successIban.textContent = result.application.masked_iban || 'sicher hinterlegt';
      if (successEmailNote) {
        successEmailNote.textContent = 'Die Eingangsbestätigung wird an ' + maskContractEmail(payload.email) + ' versendet.';
      }
      if (successDownload && confirmationUrl) {
        successDownload.href = confirmationUrl;
        successDownload.hidden = false;
      }

      contractSubmit.textContent = '✓ Bestellung erfolgreich übermittelt';
      contractForm.querySelectorAll('input,select,button').forEach(function (field) { field.disabled = true; });
      contractForm.reset();
      contractForm.classList.add('is-complete');
      contractSuccess.hidden = false;

      if (contractDisclosure) {
        var disclosureTitle = contractDisclosure.querySelector('.pdb-contract-disclosure-copy strong');
        var disclosureHint = contractDisclosure.querySelector('.pdb-contract-disclosure-copy small');
        if (disclosureTitle) disclosureTitle.textContent = 'Bestellung erfolgreich übermittelt';
        if (disclosureHint) disclosureHint.textContent = 'Ihre Referenz und Eingangsbestätigung bleiben hier abrufbar.';
      }

      if (shouldFocus !== false) {
        window.setTimeout(function () {
          contractSuccess.focus({ preventScroll: true });
          contractSuccess.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 80);
      }
    }

    function triggerSecureDownload(url) {
      var safeUrl = getSafeContractUrl(url);
      if (!safeUrl) return false;
      try {
        var link = document.createElement('a');
        link.setAttribute('href', safeUrl);
        link.hidden = true;
        document.body.appendChild(link);
        link.click();
        link.remove();
        return true;
      } catch (downloadError) {
        console.warn('Bestätigung konnte nicht automatisch geöffnet werden.', downloadError);
        return false;
      }
    }

    if (contractForm) {
      contractForm.addEventListener('submit', async function (event) {
        event.preventDefault();
        if (ibanInput) validateIbanField();
        if (!contractForm.reportValidity()) return;

        contractSubmit.disabled = true;
        contractSubmit.textContent = 'Vertrag wird sicher übermittelt…';
        if (contractProgress) contractProgress.hidden = false;
        if (contractStatus) contractStatus.classList.remove('is-visible', 'is-error');

        var formData = new FormData(contractForm);
        var payload = Object.fromEntries(formData.entries());
        payload.debit_day = Number(payload.debit_day);
        payload.confirm_age_18 = contractForm.elements.confirm_age_18.checked;
        payload.accept_agb = contractForm.elements.accept_agb.checked;
        payload.accept_withdrawal = contractForm.elements.accept_withdrawal.checked;
        payload.accept_sepa = contractForm.elements.accept_sepa.checked;
        payload.account_holder_confirmed = contractForm.elements.account_holder_confirmed.checked;
        payload.request_early_start = contractForm.elements.request_early_start.checked;

        try {
          var response = await fetch('/apps/pdb/contracts/apply', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          var responseText = await response.text();
          var result;
          try {
            result = JSON.parse(responseText);
          } catch (parseError) {
            throw new Error('Die Serverantwort konnte nicht gelesen werden. Bitte senden Sie nicht erneut ab und kontaktieren Sie uns zur Prüfung.');
          }
          if (!response.ok || !result.ok) {
            var messages = {
              CONTRACT_VERSION_CHANGED: 'Die Vertragsbedingungen wurden aktualisiert. Bitte laden Sie die Seite neu und prüfen Sie die neuen Bedingungen.',
              INVALID_IBAN: 'Bitte prüfen Sie die IBAN.',
              INVALID_CONTACT_DATA: 'Bitte füllen Sie Name, E-Mail und Anschrift vollständig aus. Straße und Hausnummer müssen gemeinsam angegeben werden.',
              INVALID_START_DATE: 'Bitte wählen Sie den ersten Tag eines kommenden Monats.',
              REQUIRED_CONSENT_MISSING: 'Bitte bestätigen Sie die Volljährigkeit sowie alle verpflichtenden Vertrags- und SEPA-Erklärungen.',
              CUSTOMER_LOGIN_REQUIRED: 'Bitte melden Sie sich erneut an und versuchen Sie es danach noch einmal.'
            };
            throw new Error(messages[result.error] || 'Der Abschluss konnte nicht gespeichert werden. Bitte prüfen Sie Ihre Angaben.');
          }

          if (contractProgress) contractProgress.hidden = true;
          var safeConfirmationUrl = getSafeContractUrl(result.confirmation_url);
          try {
            sessionStorage.setItem('pdb_contract_token', result.public_token);
            sessionStorage.setItem('pdb_contract_id', result.application.id);
          } catch (storageError) {
            console.warn('Vertragsreferenz konnte nicht im Sitzungsspeicher abgelegt werden.', storageError);
          }
          showContractSuccess(result, payload, safeConfirmationUrl);
          triggerSecureDownload(safeConfirmationUrl);
        } catch (error) {
          if (contractProgress) contractProgress.hidden = true;
          showContractStatus(error.message || 'Technischer Fehler beim Vertragsabschluss.', true);
          contractSubmit.disabled = false;
          contractSubmit.textContent = 'Mitgliedschaft zahlungspflichtig abschließen';
        }
      });
    }

  })();
</script>




