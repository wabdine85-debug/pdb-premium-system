 <script>


  (function () {
    var root = document.querySelector('.pdb-premium-v4');
    if (!root) return;

    document.body.classList.add('pdb-premium-page');

    var shopifyCustomerId = '{{ customer.id | default: "" }}';

    var isLoggedIn = !!shopifyCustomerId;
    var isPremiumMember = false;

    var cats = root.querySelectorAll('.pdb-cat');
    if (cats.length) {
      cats.forEach(function (cat) {
        var btn = cat.querySelector('.pdb-cat-btn');
        var panel = cat.querySelector('.pdb-cat-panel');
        var moreBtn = cat.querySelector('.pdb-treatment-more');
        var treatmentGrid = cat.querySelector('.pdb-treatment-grid');

        if (!btn) return;

        btn.setAttribute(
          'aria-expanded',
          cat.classList.contains('active') ? 'true' : 'false'
        );

        btn.addEventListener('click', function () {
          var shouldOpen = !cat.classList.contains('active');

          cats.forEach(function (otherCat) {
            var otherBtn = otherCat.querySelector('.pdb-cat-btn');
            var otherPanel = otherCat.querySelector('.pdb-cat-panel');
            var otherMoreBtn = otherCat.querySelector('.pdb-treatment-more');
            var otherTreatmentGrid = otherCat.querySelector('.pdb-treatment-grid');

            otherCat.classList.remove('active');
            if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
            if (otherPanel) otherPanel.hidden = true;
            if (otherTreatmentGrid) {
              otherTreatmentGrid.classList.remove('is-expanded');
            }
            if (otherMoreBtn) {
              otherMoreBtn.setAttribute('aria-expanded', 'false');
              if (otherMoreBtn.dataset.collapsedLabel) {
                otherMoreBtn.textContent = otherMoreBtn.dataset.collapsedLabel;
              }
            }
          });

          if (shouldOpen) {
            cat.classList.add('active');
            btn.setAttribute('aria-expanded', 'true');
            if (panel) panel.hidden = false;
          }
        });

        if (panel) {
          panel.hidden = !cat.classList.contains('active');
        }

        if (moreBtn && treatmentGrid) {
          var expandedLabel = moreBtn.textContent.trim();
          var collapsedLabel = 'Weniger Behandlungen anzeigen';
          moreBtn.dataset.collapsedLabel = expandedLabel;

          moreBtn.addEventListener('click', function () {
            var isExpanded = treatmentGrid.classList.toggle('is-expanded');
            moreBtn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
            moreBtn.textContent = isExpanded ? collapsedLabel : expandedLabel;
          });
        }
      });
    }

    var contractForm = document.getElementById('pdb-membership-contract-form');
    var packageSelect = document.getElementById('pdb-package');
    var contractTotal = document.getElementById('pdb-contract-total');
    var contractMonthly = document.getElementById('pdb-contract-monthly');
    var orderPackage = document.getElementById('pdb-order-package');
    var orderMonthly = document.getElementById('pdb-order-monthly');
    var contractStatus = document.getElementById('pdb-contract-status');
    var contractSubmit = document.getElementById('pdb-contract-submit');
    var packageOffers = {
      pure: { name: 'PURE', monthly: '149,00 €', monthlyHero: '149 € / Monat', total: '1.827,00 €' },
      define: { name: 'DEFINE', monthly: '169,00 €', monthlyHero: '169 € / Monat', total: '2.067,00 €' },
      beyond: { name: 'BEYOND', monthly: '199,00 €', monthlyHero: '199 € / Monat', total: '2.427,00 €' },
      private: { name: 'PRIVATE', monthly: '399,00 €', monthlyHero: '399 € / Monat', total: '4.827,00 €' }
    };

    function updateSelectedPackage(packageKey) {
      if (!packageOffers[packageKey]) return;
      if (packageSelect) packageSelect.value = packageKey;
      if (contractTotal) contractTotal.textContent = packageOffers[packageKey].total;
      if (contractMonthly) contractMonthly.textContent = packageOffers[packageKey].monthlyHero;
      if (orderPackage) orderPackage.textContent = packageOffers[packageKey].name;
      if (orderMonthly) orderMonthly.textContent = packageOffers[packageKey].monthly;
      root.querySelectorAll('[data-package-card]').forEach(function (card) {
        card.classList.toggle('is-selected', card.getAttribute('data-package-card') === packageKey);
      });
    }

    root.querySelectorAll('[data-pdb-package]').forEach(function (button) {
      button.addEventListener('click', function () {
        updateSelectedPackage(button.getAttribute('data-pdb-package'));
      });
    });

    if (packageSelect) {
      packageSelect.addEventListener('change', function () {
        updateSelectedPackage(packageSelect.value);
      });
      updateSelectedPackage(packageSelect.value);
    }

    var startInput = document.getElementById('pdb-start');
    if (startInput && !startInput.value) {
      var now = new Date();
      var nextStart = new Date(now.getFullYear(), now.getMonth() + 1, 1, 12, 0, 0);
      var startValue = nextStart.getFullYear() + '-' + String(nextStart.getMonth() + 1).padStart(2, '0') + '-01';
      startInput.value = startValue;
      startInput.min = startValue;
    }

    var ibanInput = document.getElementById('pdb-iban');
    if (ibanInput) {
      ibanInput.addEventListener('input', function () {
        var compact = ibanInput.value.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 34);
        ibanInput.value = compact.replace(/(.{4})/g, '$1 ').trim();
      });
    }

    function showContractStatus(message, isError) {
      if (!contractStatus) return;
      contractStatus.classList.add('is-visible');
      contractStatus.classList.toggle('is-error', !!isError);
      contractStatus.innerHTML = message;
    }

    if (contractForm) {
      contractForm.addEventListener('submit', async function (event) {
        event.preventDefault();
        if (!contractForm.reportValidity()) return;

        contractSubmit.disabled = true;
        contractSubmit.textContent = 'Vertrag wird sicher übermittelt…';
        showContractStatus('Ihre Angaben werden geprüft und verschlüsselt gespeichert.', false);

        var formData = new FormData(contractForm);
        var payload = Object.fromEntries(formData.entries());
        payload.debit_day = Number(payload.debit_day);
        payload.accept_agb = contractForm.elements.accept_agb.checked;
        payload.accept_withdrawal = contractForm.elements.accept_withdrawal.checked;
        payload.accept_sepa = contractForm.elements.accept_sepa.checked;
        payload.request_early_start = contractForm.elements.request_early_start.checked;

        try {
          var response = await fetch('/apps/pdb/contracts/apply', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          var result = await response.json();
          if (!response.ok || !result.ok) {
            var messages = {
              INVALID_IBAN: 'Bitte prüfen Sie die IBAN.',
              INVALID_START_DATE: 'Bitte wählen Sie den ersten Tag eines kommenden Monats.',
              REQUIRED_CONSENT_MISSING: 'Bitte bestätigen Sie die verpflichtenden Vertrags- und SEPA-Erklärungen.',
              CUSTOMER_LOGIN_REQUIRED: 'Bitte melden Sie sich erneut an und versuchen Sie es danach noch einmal.'
            };
            throw new Error(messages[result.error] || 'Der Abschluss konnte nicht gespeichert werden. Bitte prüfen Sie Ihre Angaben.');
          }

          sessionStorage.setItem('pdb_contract_token', result.public_token);
          sessionStorage.setItem('pdb_contract_id', result.application.id);
          showContractStatus(
            '<strong>Ihr Antrag ist eingegangen.</strong><br>Mandatsreferenz: ' + result.application.mandate_reference +
            '<br>Wir richten den Einzug bei der Naspa ein und schalten anschließend Ihren Mitgliederbereich frei.' +
            '<br><br><a class="pdb-btn-secondary" href="' + result.confirmation_url + '">Vertragsbestätigung herunterladen</a>',
            false
          );
          contractForm.querySelectorAll('input,select,button').forEach(function (field) { field.disabled = true; });
        } catch (error) {
          showContractStatus(error.message || 'Technischer Fehler beim Vertragsabschluss.', true);
          contractSubmit.disabled = false;
          contractSubmit.textContent = 'Mitgliedschaft zahlungspflichtig abschließen';
        }
      });
    }

    var statusBox = document.createElement('div');
    statusBox.id = 'pdb-premium-api-status';
    statusBox.style.marginTop = '18px';
    statusBox.style.padding = '14px 16px';
    statusBox.style.borderRadius = '14px';
    statusBox.style.background = '#f8f4ef';
    statusBox.style.border = '1px solid rgba(0,0,0,.08)';
    statusBox.style.fontSize = '14px';
    statusBox.style.lineHeight = '1.6';
    statusBox.style.color = '#171717';
    statusBox.setAttribute('role', 'status');
    statusBox.setAttribute('aria-live', 'polite');
    statusBox.innerHTML = 'Premium-Daten werden geladen...';

    var bookingApp = document.getElementById('pdb-premium-booking-app');
    var memberSummary = document.getElementById('pdb-premium-member-summary');
    var memberArea =
      root.querySelector('.pdb-member-gate') ||
      root.querySelector('.pdb-member-booking-card') ||
      root.querySelector('.pdb-member-gate-card') ||
      root;

    async function loadContractManagement() {
      if (!isLoggedIn || !memberArea) return;
      try {
        var response = await fetch('/apps/pdb/contracts/mine?pdb_ts=' + Date.now());
        var result = await response.json();
        if (!response.ok || !result.ok || !result.application) return;
        var application = result.application;

        if (application.status === 'sepa_pending') {
          var pending = document.createElement('div');
          pending.className = 'pdb-member-booking-card';
          pending.innerHTML = '<span class="pdb-member-badge">SEPA-Einrichtung ausstehend</span><h3>Ihr Antrag wird vorbereitet</h3><p>Mandatsreferenz: ' + application.mandate_reference + '. Nach der Einrichtung bei der Naspa wird Ihr Paket automatisch freigeschaltet.</p>';
          memberArea.appendChild(pending);
          return;
        }

        if (application.status !== 'active') return;
        var card = document.createElement('div');
        card.className = 'pdb-member-booking-card';
        card.id = 'pdb-contract-cancellation';
        card.innerHTML =
          '<h3>Mitgliedschaft verwalten</h3>' +
          '<p>Vertrag ' + application.mandate_reference + ' · Paket ' + String(application.package_key).toUpperCase() + '</p>' +
          '<button type="button" class="pdb-btn-secondary" id="pdb-open-cancellation">Verträge hier kündigen</button>' +
          '<div id="pdb-cancellation-panel" hidden style="margin-top:16px;display:grid;gap:12px">' +
            '<label class="pdb-contract-field"><span style="display:block;margin-bottom:6px;font-weight:700">Art der Kündigung</span><select id="pdb-cancellation-type"><option value="ordinary">Ordentlich zum nächstmöglichen Zeitpunkt</option><option value="extraordinary">Außerordentlich aus wichtigem Grund</option></select></label>' +
            '<label class="pdb-contract-field"><span style="display:block;margin-bottom:6px;font-weight:700">Grund bei außerordentlicher Kündigung</span><input id="pdb-cancellation-reason" maxlength="500"></label>' +
            '<button type="button" class="pdb-btn" id="pdb-confirm-cancellation">jetzt kündigen</button>' +
            '<div class="pdb-contract-status" id="pdb-cancellation-status" role="status" aria-live="polite"></div>' +
          '</div>';
        memberArea.appendChild(card);

        var openButton = card.querySelector('#pdb-open-cancellation');
        var panel = card.querySelector('#pdb-cancellation-panel');
        var confirmButton = card.querySelector('#pdb-confirm-cancellation');
        var cancellationStatus = card.querySelector('#pdb-cancellation-status');
        openButton.addEventListener('click', function () {
          panel.hidden = false;
          openButton.hidden = true;
        });
        confirmButton.addEventListener('click', async function () {
          var cancellationType = card.querySelector('#pdb-cancellation-type').value;
          var reason = card.querySelector('#pdb-cancellation-reason').value.trim();
          if (cancellationType === 'extraordinary' && !reason) {
            cancellationStatus.className = 'pdb-contract-status is-visible is-error';
            cancellationStatus.textContent = 'Bitte geben Sie den wichtigen Grund für die außerordentliche Kündigung an.';
            return;
          }
          confirmButton.disabled = true;
          var cancelResponse = await fetch('/apps/pdb/contracts/cancel', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ application_id: application.id, cancellation_type: cancellationType, reason: reason })
          });
          var cancelResult = await cancelResponse.json();
          if (!cancelResponse.ok || !cancelResult.ok) {
            cancellationStatus.className = 'pdb-contract-status is-visible is-error';
            cancellationStatus.textContent = 'Die Kündigung konnte nicht übermittelt werden. Bitte versuchen Sie es erneut.';
            confirmButton.disabled = false;
            return;
          }
          cancellationStatus.className = 'pdb-contract-status is-visible';
          cancellationStatus.innerHTML = '<strong>Kündigung ist eingegangen.</strong><br>Vorgesehenes Vertragsende: ' + cancelResult.confirmation.effective_on + '<br><a class="pdb-btn-secondary" href="' + cancelResult.confirmation_url + '" style="margin-top:10px">Bestätigung herunterladen</a>';
          confirmButton.hidden = true;
        });
      } catch (error) {
        console.error('Vertragsverwaltung konnte nicht geladen werden:', error);
      }
    }

    if (memberSummary) {
      memberSummary.insertAdjacentElement('afterend', statusBox);
    } else {
      memberArea.appendChild(statusBox);
    }

    function formatPremiumMonth(value) {
      var match = String(value || '').match(/^(\d{4})-(\d{2})(?:-\d{2})?$/);

      if (!match) return '';

      var year = Number(match[1]);
      var month = Number(match[2]);

      if (month < 1 || month > 12) return '';

      return new Intl.DateTimeFormat('de-DE', {
        month: 'long',
        timeZone: 'Europe/Berlin'
      }).format(new Date(year, month - 1, 1, 12, 0, 0));
    }

    function renderTreatments(treatments) {
      if (!bookingApp) return;

      if (!Array.isArray(treatments) || !treatments.length) {
        bookingApp.innerHTML =
          '<div style="padding:14px 16px;border-radius:14px;background:#fff;border:1px solid rgba(0,0,0,.08);font-size:14px;line-height:1.6;color:#171717;">' +
          'Aktuell sind für diesen Monat keine weiteren Premium-Behandlungen verfügbar.' +
          '</div>';
        return;
      }

      var html = '<div style="display:grid;gap:12px;">';

      treatments.forEach(function (t) {
        html +=
          '<div style="padding:14px 16px;border-radius:14px;background:#fff;border:1px solid rgba(0,0,0,.08);">' +
          '<div style="font-weight:600;font-size:15px;line-height:1.5;color:#171717;">' +
          (t.title || 'Behandlung') +
          '</div>' +
          '<button class="pdb-btn pdb-book-treatment" data-treatment-key="' + t.treatment_key + '" style="margin-top:10px;">' +
          'Termin buchen' +
          '</button>' +
          '</div>';
      });

      html += '</div>';
      bookingApp.innerHTML = html;
    }

      var PDB_PREMIUM_TAGS = [
  {% if is_private %}
    'premium-private'
  {% elsif is_beyond %}
    'premium-beyond'
  {% elsif is_define %}
    'premium-define'
  {% elsif is_pure %}
    'premium-pure'
  {% endif %}
].filter(Boolean);

    async function loadAllowedTreatments() {
      try {
        if (!isLoggedIn) {
          if (statusBox) {
            statusBox.innerHTML = 'Bitte logge dich ein, um deine Premium-Mitgliedschaft zu nutzen.';
          }

          if (bookingApp) {
            bookingApp.innerHTML = '';
          }

          return;
        }

        var res = await fetch(
          '/apps/pdb/allowed?email={{ customer.email | url_encode }}' +
          '&firstName={{ customer.first_name | url_encode }}' +
          '&lastName={{ customer.last_name | url_encode }}' +
          '&tags=' + encodeURIComponent(Array.isArray(PDB_PREMIUM_TAGS) ? PDB_PREMIUM_TAGS.join(',') : '') +
          '&pdb_ts=' + Date.now(),
          {
            method: 'GET'
          }
        );

        var data = await res.json();
        console.log('PDB Premium allowed treatments response:', data);

        if (!data.ok) {
          console.error('API returned error:', data);

          statusBox.innerHTML =
            'Premium-Daten konnten aktuell nicht geladen werden.<br>' +
            'Shopify-ID: ' + shopifyCustomerId + '<br>' +
            'Fehler: ' + (data.error || 'Unbekannt');

          if (bookingApp) {
            bookingApp.innerHTML = '';
          }

          return;
        }

        var member = data.member || null;

        isPremiumMember =
          !!member &&
          member.status === 'active' &&
          ['pure', 'define', 'beyond', 'private'].includes(member.package_key);

        if (!isPremiumMember) {
          statusBox.innerHTML =
            '<strong>PDB PREMIUM</strong><br>' +
            'Für dieses Kundenkonto wurde aktuell keine aktive Premium-Mitgliedschaft gefunden.';

          if (bookingApp) {
            bookingApp.innerHTML = '';
          }

          return;
        }

        console.log('Member:', data.member);
        console.log('Entitlements:', data.entitlements);
        console.log('Treatments:', data.treatments);

        var packageKey = data.member && data.member.package_key ? data.member.package_key.toUpperCase() : '-';

        if (memberSummary) {
  var summaryText = '';

  if (packageKey === 'PURE') {
    summaryText = 'Sie können pro Kalendermonat 3 frei wählbare Behandlungen aus der PURE Kollektion buchen. Mehrfachbuchungen derselben Behandlung sind möglich. Nicht genutzte Leistungen verfallen am Monatsende.';
  } else if (packageKey === 'DEFINE') {
    summaryText = 'Sie können pro Kalendermonat 1 Behandlung aus PURE und 1 Behandlung aus DEFINE buchen. Nicht genutzte Leistungen verfallen am Monatsende.';
  } else if (packageKey === 'BEYOND') {
    summaryText = 'Sie können pro Kalendermonat 1 exklusive Behandlung aus der BEYOND Kollektion buchen. Nicht genutzte Leistungen verfallen am Monatsende.';
  } else if (packageKey === 'PRIVATE') {
    summaryText = 'Sie können pro Kalendermonat 1 vollständiges Protokoll aus der PRIVATE Kollektion buchen. Nicht genutzte Leistungen verfallen am Monatsende.';
  }

  memberSummary.innerHTML =
    '<span class="pdb-member-badge">Aktiver Status: ' + packageKey + ' aktiv</span>' +
    '<h3>Ihr freigeschalteter Mitgliederbereich</h3>' +
    '<p>' + summaryText + '</p>';
}

        var remainingPure = data.entitlements && data.entitlements.remaining ? data.entitlements.remaining.pure : 0;
        var remainingDefine = data.entitlements && data.entitlements.remaining ? data.entitlements.remaining.define : 0;
        var remainingBeyond = data.entitlements && data.entitlements.remaining ? data.entitlements.remaining.beyond : 0;
        var remainingPrivate = data.entitlements && data.entitlements.remaining ? data.entitlements.remaining.private : 0;
        var nextRemainingPure = data.nextMonthEntitlements && data.nextMonthEntitlements.remaining ? data.nextMonthEntitlements.remaining.pure : 0;
        var nextRemainingDefine = data.nextMonthEntitlements && data.nextMonthEntitlements.remaining ? data.nextMonthEntitlements.remaining.define : 0;
        var nextRemainingBeyond = data.nextMonthEntitlements && data.nextMonthEntitlements.remaining ? data.nextMonthEntitlements.remaining.beyond : 0;
        var nextRemainingPrivate = data.nextMonthEntitlements && data.nextMonthEntitlements.remaining ? data.nextMonthEntitlements.remaining.private : 0;
        var treatmentCount = Array.isArray(data.treatments) ? data.treatments.length : 0;
        var currentQuotaText = '';
        var nextQuotaText = '';
        var currentRemainingTotal = 0;
        var nextRemainingTotal = 0;

        if (packageKey === 'PURE') {
          currentQuotaText = remainingPure + ' PURE';
          nextQuotaText = nextRemainingPure + ' PURE';
          currentRemainingTotal = remainingPure;
          nextRemainingTotal = nextRemainingPure;
        } else if (packageKey === 'DEFINE') {
          currentQuotaText = remainingPure + ' PURE · ' + remainingDefine + ' DEFINE';
          nextQuotaText = nextRemainingPure + ' PURE · ' + nextRemainingDefine + ' DEFINE';
          currentRemainingTotal = remainingPure + remainingDefine;
          nextRemainingTotal = nextRemainingPure + nextRemainingDefine;
        } else if (packageKey === 'BEYOND') {
          currentQuotaText = remainingBeyond + ' BEYOND';
          nextQuotaText = nextRemainingBeyond + ' BEYOND';
          currentRemainingTotal = remainingBeyond;
          nextRemainingTotal = nextRemainingBeyond;
        } else {
          currentQuotaText = remainingPrivate + ' PRIVATE';
          nextQuotaText = nextRemainingPrivate + ' PRIVATE';
          currentRemainingTotal = remainingPrivate;
          nextRemainingTotal = nextRemainingPrivate;
        }

        var currentMonthLabel = formatPremiumMonth(
          data.entitlements && data.entitlements.month
        );
        var nextMonthLabel = formatPremiumMonth(
          data.nextMonthEntitlements && data.nextMonthEntitlements.month
        );
        var guidanceHtml = '';

        if (
          currentRemainingTotal === 0 &&
          nextRemainingTotal > 0 &&
          currentMonthLabel &&
          nextMonthLabel
        ) {
          var treatmentLabel = packageKey === 'PRIVATE'
            ? 'PRIVATE-Protokoll'
            : packageKey === 'BEYOND' ? 'BEYOND-Behandlung' : 'Premium-Behandlung';

          guidanceHtml =
            '<div class="pdb-booking-guidance">' +
            '<strong>' + currentMonthLabel + ' bereits genutzt</strong>' +
            '<span>Ihre nächste ' + treatmentLabel + ' können Sie für ' + nextMonthLabel + ' buchen.</span>' +
            '</div>';
        }

        statusBox.innerHTML =
          '<strong>Dein Kontingent</strong>' +
          '<div class="pdb-quota-row"><span>Aktueller Monat</span><strong>' + currentQuotaText + '</strong></div>' +
          '<div class="pdb-quota-row"><span>Nächster Monat</span><strong>' + nextQuotaText + '</strong></div>' +
          '<div class="pdb-quota-row"><span>Buchbare Behandlungen</span><strong>' + treatmentCount + '</strong></div>' +
          guidanceHtml;

        renderTreatments(data.treatments);
      } catch (error) {
        console.error('Fehler beim Laden der erlaubten Treatments:', error);
        statusBox.innerHTML = 'Technischer Fehler beim Laden der Premium-Daten.';

        if (bookingApp) {
          bookingApp.innerHTML = '';
        }
      }
    }

    loadAllowedTreatments();
    loadContractManagement();

    document.addEventListener('click', async function (e) {
      var btn = e.target.closest('.pdb-book-treatment');
      if (!btn) return;

      if (!isPremiumMember) {
        if (statusBox) {
          statusBox.innerHTML =
            '<strong>PDB PREMIUM</strong><br>' +
            'Du hast aktuell keine aktive Premium-Mitgliedschaft.<br><br>' +
            'Als Mitglied erhältst du monatlich exklusive Behandlungen und direkten Zugang zur Online-Buchung.';
        }

        if (bookingApp) {
          bookingApp.innerHTML =
            '<div style="text-align:center; padding:24px;">' +
            '<a href="/pages/premium" style="display:inline-block; background:#d9bfa9; color:#fff; padding:12px 20px; border-radius:10px; text-decoration:none; font-weight:600;">' +
            'Mitgliedschaft ansehen' +
            '</a>' +
            '</div>';
        }

        return;
      }

      var key = btn.getAttribute('data-treatment-key');
      if (!key) return;

      btn.disabled = true;
      var originalText = btn.innerText;
      btn.innerText = 'Wird geöffnet...';

        var params = new URLSearchParams();

params.set('email', '{{ customer.email | escape }}');
params.set('firstName', '{{ customer.first_name | escape }}');
params.set('lastName', '{{ customer.last_name | escape }}');
params.set('tags', Array.isArray(PDB_PREMIUM_TAGS) ? PDB_PREMIUM_TAGS.join(',') : '');

var res = await fetch('/apps/pdb/member/allowed?' + params.toString(), {
  method: 'GET'
});

          try {
        var res = await fetch('/apps/pdb/bookings/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            treatment_key: key,
            shopify_customer_id: shopifyCustomerId
          })
        });

        var data = await res.json();

        if (!data.ok || !data.token) {
          var message = 'Buchung aktuell nicht möglich.';

          if (data.error === 'LIMIT_REACHED') {
            message = 'Dein monatliches Kontingent für dieses Paket ist bereits aufgebraucht.';
          } else if (data.error === 'TREATMENT_NOT_ALLOWED') {
            message = 'Diese Behandlung ist in deinem aktuellen Paket nicht enthalten.';
          } else if (data.error === 'MEMBER_NOT_FOUND') {
            message = 'Für dein Kundenkonto wurde keine aktive Premium-Mitgliedschaft gefunden.';
          } else if (data.error === 'TREATMENT_KEY_REQUIRED') {
            message = 'Die Behandlung konnte nicht korrekt übergeben werden.';
          }

          alert(message);
          btn.disabled = false;
          btn.innerText = originalText;
          return;
        }

        var consumeRes = await fetch('/apps/pdb/bookings/consume', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            token: data.token,
            shopify_customer_id: shopifyCustomerId
          })
        });

        var consumeData = await consumeRes.json();

        if (!consumeData.ok || !consumeData.booking_url) {
          var consumeMessage = 'Buchungslink konnte nicht geöffnet werden.';

          if (consumeData.error === 'TOKEN_ALREADY_USED') {
            consumeMessage = 'Dieser Buchungslink wurde bereits verwendet.';
          } else if (consumeData.error === 'TOKEN_NOT_FOUND') {
            consumeMessage = 'Der Buchungslink ist ungültig oder nicht mehr verfügbar.';
          } else if (consumeData.error === 'TOKEN_EXPIRED') {
            consumeMessage = 'Der Buchungslink ist abgelaufen. Bitte starte die Buchung erneut.';
          } else if (consumeData.error === 'MEMBER_NOT_FOUND') {
            consumeMessage = 'Für dieses Kundenkonto wurde keine aktive Premium-Mitgliedschaft gefunden.';
          }

          alert(consumeMessage);
          btn.disabled = false;
          btn.innerText = originalText;
          return;
        }

        window.open(consumeData.booking_url, '_blank', 'noopener');

        btn.disabled = false;
        btn.innerText = originalText;
      } catch (err) {
        console.error(err);
        alert('Technischer Fehler bei der Buchung.');
        btn.disabled = false;
        btn.innerText = originalText;
      }
    });
  })();
</script>

<script>
document.addEventListener("click", function (e) {
  var btn = e.target.closest(".pdb-book-treatment");
  if (!btn) return;

  e.preventDefault();
  e.stopPropagation();
  e.stopImmediatePropagation();

  var key = btn.getAttribute("data-treatment-key");
  if (!key) return;

  window.location.href = "/products/" + key;
}, true);
</script>


