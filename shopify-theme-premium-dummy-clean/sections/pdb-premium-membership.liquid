    }

        .pdb-premium-v4 .pdb-btn-member{
      position:relative;
      display:inline-flex;
      -webkit-animation:pdbMemberBounce 1.5s ease-in-out infinite;
      animation:pdbMemberBounce 1.5s ease-in-out infinite;
      -webkit-transform:translateZ(0);
      transform:translateZ(0);
      will-change:transform, box-shadow;
      box-shadow:0 10px 26px rgba(185,144,111,.18);
    }

    .pdb-premium-v4 .pdb-btn-member::before{
      content:"";
      position:absolute;
      inset:-4px;
      border-radius:18px;
      border:1px solid rgba(217,191,169,.30);
      pointer-events:none;
      -webkit-animation:pdbMemberGlow 1.5s ease-in-out infinite;
      animation:pdbMemberGlow 1.5s ease-in-out infinite;
    }

    @-webkit-keyframes pdbMemberBounce{
      0%,100%{
        -webkit-transform:translateY(0) scale(1);
        transform:translateY(0) scale(1);
        box-shadow:0 10px 26px rgba(185,144,111,.18);
      }
      50%{
        -webkit-transform:translateY(-4px) scale(1.03);
        transform:translateY(-4px) scale(1.03);
        box-shadow:0 18px 38px rgba(185,144,111,.28);
      }
    }

    @keyframes pdbMemberBounce{
      0%,100%{
        -webkit-transform:translateY(0) scale(1);
        transform:translateY(0) scale(1);
        box-shadow:0 10px 26px rgba(185,144,111,.18);
      }
      50%{
        -webkit-transform:translateY(-4px) scale(1.03);
        transform:translateY(-4px) scale(1.03);
        box-shadow:0 18px 38px rgba(185,144,111,.28);
      }
    }

    @-webkit-keyframes pdbMemberGlow{
      0%,100%{
        opacity:.25;
        -webkit-transform:scale(1);
        transform:scale(1);
      }
      50%{
        opacity:.75;
        -webkit-transform:scale(1.05);
        transform:scale(1.05);
      }
    }

    @keyframes pdbMemberGlow{
      0%,100%{
        opacity:.25;
        -webkit-transform:scale(1);
        transform:scale(1);
      }
      50%{
        opacity:.75;
        -webkit-transform:scale(1.05);
        transform:scale(1.05);
      }
    }



